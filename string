#include<iostream>
using namespace std;
int getlength(char arr[],int size){
    int count=0;
    for(int i=0;i<size;i++){
        if(arr[i]=='\0'){
            break;
        }else{
         count++;
        }
    }
    return count;
}
void replacechar(char original,char newchar,char arr[],int size){
    for(int i=0;i<size;i++){
        if(arr[i]==original){
            arr[i]=newchar;
        }
        else{
            continue;
        }
    }

}
void reversechararray(char arr[],int size){
    int i=0;
    int j=size-1;
    while(i<=j){
        swap(arr[i],arr[j]);
        i++;j--;
    }
    cout<<arr<<endl;
}
void convertintoUpercase(char arr[],int size){
    for(int i=0;i<size;i++){
        char c=arr[i];
        if(c>='a'&&c<='z'){
            c=c-'a'+'A';
        }
        arr[i]=c;
    }
    cout<<arr;
}
void convertintoLowercase(char arr[],int size){
    for(int i=0;i<size;i++){
        char c=arr[i];
        if(c>='A'&&c<='Z'){
            c=c-'A'+'a';
        }
        arr[i]=c;
    }
    cout<<arr;
}
