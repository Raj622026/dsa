// Reverse the queue  ->> using Stack
#include<iostream>
#include<queue>
using namespace std;
void reverseQueue(queue<int>&q){
    stack<int>s;
    while(!q.empty()){
     int ele=q.front();
     q.pop();
     s.push(ele);
    }
    while(!s.empty()){
        int ele=s.top();
        s.pop();
        q.push(ele);
    }
    while(!q.empty()){
       cout<< q.front() <<" ";
       q.pop();
    }cout<<endl;
}
int main(){
    queue<int>q;
    q.push(10);
    q.push(20);
    q.push(30);
    q.push(40);
    q.push(50);
    reverseQueue(q);
   return 0;
}

