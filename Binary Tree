#include<iostream>
#include<queue>
using namespace std;
class Node{
  public:
  int data;
  Node*left;
  Node*right;
  Node(int val){
    this->data=val;
    left=NULL;
    right=NULL;

  }
};
Node* Create_tree(){
    int value;
    cin>>value;
    if(value==-1){
        return NULL;
    }
    else{
        Node * root=new Node(value);
        cout<<"add Left child"<<value<<endl;
        root->left= Create_tree();
        cout<<"add rifht cild:"<<value<<endl;
        root->right=Create_tree();
        return root;
    }
}
void printInorder(Node *root){
   
    if(root==NULL)return;
    printInorder(root->left);
    cout<<root->data<<" ";
    printInorder(root->right);

}
void printPostorder(Node *root){
  
    if(root==NULL)return;
     cout<<root->data<<" ";
    printPostorder(root->left);
   
    printPostorder(root->right);

}
void printPreorder(Node *root){
  
    if(root==NULL)return;
    printPreorder(root->left);
    printPreorder(root->right);
    cout<<root->data<<" ";
    

}

int main(){
    Node* root = new Node(1);
    root->left = new Node(2);
    root->right = new Node(3);

    root->left->left = new Node(4);
    root->left->right = new Node(5);
     cout<<"traversal in Inorder : ";
      printInorder(root);
      cout<<endl;
      cout<<"traversal in postorder:  ";
       printPostorder(root);
       cout<<endl;
        cout<<"traversal in preorder:  ";
        printPreorder(root);
        cout<<endl;
    return 0;

}
