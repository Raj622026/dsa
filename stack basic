//stack implement using stl;
#include<iostream>
#include<stack>
using namespace std;
int main(){
    stack<int>s;
    s.push(10);
    s.push(20);
    s.push(30);
    s.push(40);
    s.push(50);
    //size
    cout<<s.size()<<endl;
    //check empty
    cout<<s.empty()<<endl;
    //peak
    cout<<s.top();
    //
    s.pop();
    cout<<endl<<s.top();
  return 0;
}
