#include<iostream>
#include<string>
using namespace std;
void lastoccRTL(string s,int i,char x,int &ans){
    if(i<0){
        return;
    }
    if(s[i]==x){
        ans=i;
        return ;
    }
    lastoccRTL(s,i-1,x,ans);
}

int main(){
    string s;
    cin>>s;
    char x;
    cin>>x;
    int ans =-1;
    lastoccRTL(s,s.length()-1,x,ans);
   cout<<ans;
    return 0;
}
