#include<iostream>
#include<string>
using namespace std;
void lastoccRTL(string s,int i,char x,int &ans){
    if(i<0){
        return;
    }
    if(s[i]==x){
        ans=i;
        return ;
    }
    lastoccRTL(s,i-1,x,ans);
}

int main(){
    string s;
    cin>>s;
    char x;
    cin>>x;
    int ans =-1;
    lastoccRTL(s,s.length()-1,x,ans);
   cout<<ans;
    return 0;
}
#include<iostream>
#include<string>
using namespace std;
void solvepermutation(string st,int i){
     if(i>=st.length()){
        cout<<st<<" "<<endl;
        return ;
     }
     for(int j=i;j<st.length();j++){
        swap(st[i],st[j]);
        solvepermutation(st,i+1);
     }
}

 int main(){
    string st="123";
    int i=0;
    solvepermutation(st,i);

return 0;
}
