#include<iostream>
#include<vector>
using namespace std;
void mergeTwosortedArray(int arr[],int sizeArr,int brr[],int sizeBrr,vector<int>&ans){
  int i=0;
  int j=0;
  while(i<sizeArr&&j<sizeBrr){
    if(arr[i]<brr[j]){
      ans.push_back(arr[i]);
      i++;
    }
    else{
      ans.push_back(brr[j]);
        j++;
    }
  }
  while(i<sizeArr){
    ans.push_back(arr[i]);
    i++;
  }
  while(j<sizeBrr){
    ans.push_back(brr[j]);
    j++;
  }
}
int main(){
  int arr[]={20,40,60};
  int sizeArr=3;
  int brr[]={10,30,50,70,80,90,100};
  int sizeBrr=7;
  vector<int>ans;
  mergeTwosortedArray(arr,sizeArr,brr,sizeBrr,ans);
  for(int i: ans){
    cout<<i<<" ";
  }
  cout<<endl;
return 0;
}
