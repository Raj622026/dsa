// stack using reverse string
#include<iostream>
#include<stack>
using namespace std;
int main(){
  stack<char>s;
  string name="mayankraj";
  //insert string in stack
  for(int i=0;i<name.length();i++){
    char ch=name[i];
    s.push(ch);
 }
 while(!s.empty()){
 cout<<s.top()<<" ";
    s.pop();
 }
    return 0;
}

//In Stack using InserAtBottom
#include<iostream>
#include<stack>
using namespace std;
 void insertAtBottom(stack<int>&s,int val){
   //base case
   if(s.empty()){
    s.push(val);
    return;
   }
   //1 case i handle
   int topElement=s.top();
   s.pop();
    //recursion
    insertAtBottom(s,val);
    // backtrack

    s.push(topElement);
 }
int main(){
  stack<int>s;
  s.push(10);
  s.push(20);
  s.push(30);
  s.push(40);
  int val=50;
  insertAtBottom(s,val);

 while(!s.empty()){
 cout<<s.top()<<" ";
    s.pop();
 }
    return 0;
}


// find Middle using stack
#include<iostream>
#include<stack>
using namespace std;
  void middle(stack<int>& s,int count){
    //base case
    if(count==0){
        cout<<s.top();
        return;
    }
    //1 case i handle 
    int topE=s.top();
    s.pop();
    count--;
    middle(s,count);
     s.push(topE);
  }
int main(){
    stack<int>s;
    s.push(10);
    s.push(20);
    s.push(30);
    s.push(40);
    s.push(50);
    s.push(60);
    s.push(70);
    int count =s.size()/2;
    middle(s,count);
    return 0;
}

// nextSmaller and prevsmaller

#include<iostream>
#include<vector>
#include<stack>
#include<algorithm>
using namespace std;
void nextSmaller(int arr[],int n,vector<int>&ans){
  stack<int>st;
  st.push(-1);
  for(int i=n-1; i>=0; i--){
    int ele  = arr[i];
    while(st.top() >= ele){
        st.pop();
    }
    ans.push_back(st.top());
    st.push(ele);
  }
}
void prevSmaller(int arr[],int n,vector<int>&ans){
    stack<int>s;
    s.push(-1);
    for(int i=0;i<n;i++){
        int ele=arr[i];
        while(s.top()>ele){
            s.pop();
        }
        ans.push_back(s.top());
        s.push(ele);
    }
}
int main(){
   int arr[] = {8,4,6,2,3};
  int n = 5;
  vector<int>ans;
//   nextSmaller(arr,n,ans);
//   reverse(ans.begin(),ans.end());
prevSmaller(arr,n,ans);
  for(auto i:ans){
    cout<<i<<" ";
  }
    return 0;
}
